run = "npm run dev"
modules = ["nodejs-20"]
hidden = [".config", "package-lock.json"]
entrypoint = "index.html"

[nix]
channel = "stable-24_05"

[unitTest]
language = "nodejs"

[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "npm run build-storybook"]
publicDir = "storybook-static"
run = ["sh", "-c", ""]

[[ports]]
localPort = 5173
externalPort = 8000

[[ports]]
localPort = 6006
externalPort = 9000

[[ports]]
localPort = 6007
externalPort = 80

[workflows]

[[workflows.workflow]]
name = "Storybook"
author = 41896650
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run storybook"
